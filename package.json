{
  "name": "quizard",
  "version": "2.0.3",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build && npm run copy404",
    "watch": "ng build --watch --configuration development",
    "test": "vitest run",
    "copy404": "node -e \"const fs=require('fs');fs.copyFileSync('dist/quizard-ng/browser/index.html','dist/quizard-ng/browser/404.html');console.log('404 synced')\"",
    "local": "node scripts/local-dev-server.mjs",
    "site": "node scripts/local-dev-server.mjs",
    "relay:deploy": "node scripts/deploy-relay.mjs"
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@angular/service-worker": "^22.1.6",
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.1",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/status-bar": "^8.0.4",
    "@ionic/angular": "^9.0.4",
    "html2canvas": "^1.4.1",
    "idb": "^8.0.3",
    "ionicons": "^8.1.0",
    "jspdf": "^4.2.1",
    "jsqr": "^1.4.0",
    "jszip": "^3.10.2",
    "mammoth": "^1.12.2",
    "pdfjs-dist": "^6.3.289",
    "qrcode-generator": "^2.0.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.8",
    "@angular/cli": "^22.1.8",
    "@angular/compiler-cli": "^22.1.0",
    "@capacitor/cli": "^8.5.2",
    "fake-indexeddb": "^6.2.5",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^4.1.11"
  },
  "description": "Document-to-quiz study app (Ionic + Angular). PDF/PPTX/DOCX in, exam-style quizzes out."
}
